PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
# Canonical public API origin; set when a reverse proxy terminates HTTPS.
API_ORIGIN=

# Leave empty for the first smoke run. Example:
# MONGODB_URI=mongodb://127.0.0.1:27017/eotion
MONGODB_URI=

# Reserved for later phases; not required by P4.1.
REDIS_URL=
KAFKA_BROKERS=

# P4.5 file integration: apps/api connects to ali-oss-server.
# Keep the client secret on the server; never expose it to clients.
ALI_OSS_SERVER_URL=
ALI_OSS_CLIENT_ID=
ALI_OSS_CLIENT_SECRET=
ALI_OSS_OBJECT_PREFIX=eotion
ALI_OSS_MAX_UPLOAD_BYTES=20971520
