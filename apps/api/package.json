{
  "name": "@eotion/api",
  "version": "0.0.1-beta",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter @eotion/domain build && pnpm --filter @eotion/contracts build && nest start --watch",
    "build": "pnpm --filter @eotion/domain build && pnpm --filter @eotion/contracts build && nest build",
    "start": "node dist/main.js",
    "test:domain": "pnpm build && node --test dist/modules/server-domain/server-domain.test.js dist/modules/server-domain/database.test.js",
    "test:database:performance": "pnpm build && node --test dist/modules/server-domain/database-performance.test.js",
    "test:http": "pnpm build && node --test dist/modules/http-api/http-api.test.js dist/modules/http-api/database-http.test.js && node --experimental-strip-types --test src/modules/http-api/sync-http.test.mjs && node --experimental-strip-types --test src/modules/http-api/file-http.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:mcp": "pnpm build && node --test dist/modules/mcp/mcp.test.js dist/modules/mcp/mcp-read.contract.test.js dist/modules/mcp/mcp-write.contract.test.js dist/modules/mcp/mcp-write.test.js"
  },
  "dependencies": {
    "@ali-oss-server/sdk": "1.1.0",
    "@eotion/contracts": "workspace:*",
    "@eotion/domain": "workspace:*",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.4",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.4",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "mongoose": "^9.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@nestjs/cli": "^12.0.4",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  }
}
