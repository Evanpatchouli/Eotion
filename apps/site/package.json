{
  "name": "@eotion/site",
  "version": "0.0.1-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev --host 127.0.0.1 --port 7174",
    "build": "vitepress build && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "preview": "vitepress preview --host 127.0.0.1 --port 4174",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test scripts/release-notes.test.mjs && playwright test",
    "screenshots": "node scripts/capture-product.mjs"
  },
  "dependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
