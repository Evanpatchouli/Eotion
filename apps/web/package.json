{
  "name": "@eotion/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7173",
    "build": "vue-tsc --noEmit && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "test:product": "playwright test tests/product-flow.spec.ts tests/product-pages.spec.ts tests/product-editor.spec.ts tests/product-sync.spec.ts tests/product-attachments.spec.ts tests/product-settings.spec.ts",
    "test:storage": "pnpm --filter @eotion/desktop build && playwright test tests/storage.spec.ts tests/desktop-storage.spec.ts tests/desktop-product-sync.spec.ts",
    "test:offline-shell": "playwright test --config playwright.offline-shell.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:real-sync": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "@eotion/contracts": "workspace:*",
    "@eotion/domain": "workspace:*",
    "@eotion/sdk": "workspace:*",
    "@eotion/storage": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "lucide": "^1.49.0",
    "morphicons": "^1.7.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
