# Optional override for the Eotion Web app loaded by the Lynx shell.
# Development defaults to this machine's LAN IPv4 address on port 7173.
# Production builds default to https://eotion.evanpatchouli.space.
# Native packaging reads explicit process EOTION_WEB_URL, not this local .env.
EOTION_WEB_URL=http://<局域网IP>:7173
