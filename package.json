{
  "name": "eotion",
  "version": "0.0.1",
  "private": true,
  "description": "Eotion - a Notion-inspired web-first knowledge workspace",
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": ">=22.12 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev:web": "pnpm --filter @eotion/web dev",
    "dev:desktop": "pnpm --filter @eotion/desktop dev",
    "dev:mobile": "pnpm --filter @eotion/mobile dev",
    "dev:api": "pnpm --filter @eotion/api dev",
    "build:web": "pnpm --filter @eotion/web build",
    "build:desktop": "pnpm --filter @eotion/desktop build",
    "build:mobile": "pnpm --filter @eotion/mobile build",
    "mobile:android:apk": "node scripts/package-mobile.mjs android apk",
    "mobile:android:aab": "node scripts/package-mobile.mjs android aab",
    "mobile:harmony:hap": "node scripts/package-mobile.mjs harmony hap",
    "mobile:harmony:app": "node scripts/package-mobile.mjs harmony app",
    "build:api": "pnpm --filter @eotion/api build",
    "desktop:installer": "pnpm --filter @eotion/desktop installer",
    "desktop:portable": "pnpm --filter @eotion/desktop portable",
    "desktop:zip": "pnpm --filter @eotion/desktop zip",
    "desktop:release": "pnpm --filter @eotion/desktop release",
    "build": "pnpm build:web && pnpm build:desktop && pnpm build:mobile && pnpm build:api",
    "typecheck": "pnpm --filter @eotion/web typecheck && pnpm --filter @eotion/desktop typecheck && pnpm --filter @eotion/api typecheck",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "version:set": "node scripts/version.mjs set",
    "build:bump": "node scripts/version.mjs build",
    "dev:site": "pnpm --filter @eotion/site dev",
    "build:site": "pnpm --filter @eotion/site build",
    "preview:site": "pnpm --filter @eotion/site preview"
  },
  "eotion": {
    "buildNumber": 1
  }
}
