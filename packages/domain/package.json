{
  "name": "@eotion/domain",
  "version": "0.0.1-beta",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./block-types": {
      "types": "./src/block-types.ts",
      "node": "./dist/block-types.js",
      "import": "./src/block-types.ts",
      "require": "./dist/block-types.js",
      "default": "./dist/block-types.js"
    },
    "./database": {
      "types": "./src/database.ts",
      "node": "./dist/database.js",
      "import": "./src/database.ts",
      "require": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./order": {
      "types": "./src/order.ts",
      "import": "./src/order.ts",
      "require": "./dist/order.js",
      "default": "./dist/order.js"
    },
    "./block-tree": {
      "types": "./src/block-tree.ts",
      "node": "./dist/block-tree.js",
      "import": "./src/block-tree.ts",
      "default": "./src/block-tree.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
