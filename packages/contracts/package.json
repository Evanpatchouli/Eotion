{
  "name": "@eotion/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mobile": {
      "types": "./src/mobile.ts",
      "node": "./dist/mobile.js",
      "import": "./src/mobile.ts",
      "require": "./dist/mobile.js",
      "default": "./dist/mobile.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test src/mobile.test.cjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@eotion/domain": "workspace:*",
    "zod": "^4.6.5"
  }
}
